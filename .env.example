# Copy to .env and set your own values. Never commit a real .env file.
# Clerk: https://dashboard.clerk.com/ -> API keys
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/talentbridge

# Development client and API origins
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Client-side API base URL (Vite exposes VITE_ variables to the browser)
VITE_API_BASE_URL=http://localhost:4000/api/v1
